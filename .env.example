# =====================================================================
# n8n-outbound-sequence-step-pacing-optimization-engine — sample .env
# All values are placeholders. Never commit a filled-in copy of this file.
# =====================================================================

# --- n8n runtime (self-hosted) — lets Code nodes and expressions read $env
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
GENERIC_TIMEZONE=UTC

# --- Safety flags (safe defaults; flip only when promoting to production)
SANDBOX_MODE=true
DRY_RUN=true
PACING_UPDATES_ENABLED=false
SEND_SLACK_ALERTS=false
SEND_WEBHOOK_ALERTS=false
ALERT_MIN_SEVERITY=WARNING

# --- Outbound platform / adapter (secrets: set in your secret manager)
OUTBOUND_PLATFORM=generic
OUTBOUND_API_BASE_URL=https://api.outbound-platform.example.com/v1
OUTBOUND_API_KEY=
OUTBOUND_MAILBOX_HEALTH_PATH=/mailboxes/health
OUTBOUND_CAMPAIGN_METRICS_PATH=/campaigns/sequence-metrics
OUTBOUND_PACING_UPDATE_PATH=/campaigns/{campaign_id}/sequence-delays
OUTBOUND_CAMPAIGN_IDS=77001,77002,77003
METRICS_LOOKBACK_DAYS=7

# --- Alert destinations (secrets)
SLACK_ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
ALERT_MAX_ITEMS_PER_SECTION=8

# --- Mailbox health thresholds (percent)
BOUNCE_RATE_WARN_PCT=2.0
BOUNCE_RATE_THROTTLE_PCT=3.0
BOUNCE_RATE_CRITICAL_PCT=5.0
SPAM_RATE_WARN_PCT=0.1
SPAM_RATE_CRITICAL_PCT=0.3
VOLUME_UTILIZATION_WARN_PCT=90
WARMUP_REPUTATION_FLOOR_PCT=90
MIN_MAILBOX_SAMPLE_SIZE=50
UNSUBSCRIBE_RATE_GUARD_PCT=1.0

# --- Step delay bounds & smoothing
MIN_STEP_DELAY_DAYS=2
MAX_STEP_DELAY_DAYS=10
MAX_DELAY_CHANGE_DAYS_PER_RUN=2
MIN_STEP_SAMPLE_SIZE=100
MAX_CAMPAIGNS_UPDATED_PER_RUN=25

# --- Engagement velocity model
BENCHMARK_REPLY_RATE_PCT=2.0
BENCHMARK_CLICK_RATE_PCT=1.5
BENCHMARK_HOURS_TO_ENGAGEMENT=48
VELOCITY_HIGH_THRESHOLD=1.3
VELOCITY_SLUGGISH_THRESHOLD=0.8
VELOCITY_STALLED_THRESHOLD=0.5
VELOCITY_COMPRESS_MULTIPLIER=0.75
VELOCITY_EXPAND_MULTIPLIER=1.35
VELOCITY_STALLED_MULTIPLIER=1.6
VELOCITY_SHIFT_ALERT_PCT=25

# --- Health multipliers
HEALTH_WATCH_MULTIPLIER=1.15
HEALTH_THROTTLE_MULTIPLIER=1.5

# --- Circuit breaker
CIRCUIT_BREAKER_CRITICAL_MAILBOX_PCT=30
CIRCUIT_BREAKER_BOUNCE_RATE_PCT=5.0
